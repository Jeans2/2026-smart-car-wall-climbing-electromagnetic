  579   1          uint32 budget_us = DL1A_GET_START_OVERHEAD + DL1A_END_OVERHEAD;
  580   1          
  581   1          dl1a_get_sequence_step_enables(&enables);
  582   1          dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  583   1          
  584   1          if(enables.tcc)
  585   1          {
  586   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  587   2          }
  588   1          
  589   1          if(enables.dss)
  590   1          {
  591   2              budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  592   2          }
  593   1          else if(enables.msrc)
  594   1          {
  595   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  596   2          }
  597   1          
  598   1          if(enables.pre_range)
  599   1          {
  600   2              budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  601   2          }
  602   1          
  603   1          if(enables.final_range)
  604   1          {
  605   2              budget_us += (timeouts.final_range_us + DL1A_FINALlRANGE_OVERHEAD);
  606   2          }
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/05/26  17:37:24  PAGE 11  

  607   1          
  608   1          return budget_us;
  609   1      }
