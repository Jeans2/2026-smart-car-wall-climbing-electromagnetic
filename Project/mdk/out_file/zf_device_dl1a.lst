  366          // 使用示例     dl1a_get_vcsel_pulse_period(DL1A_VCSEL_PERIOD_PER_RANGE);
  367          // 备注信息     在 PCLKs 中获取给定周期类型的 VCSEL 脉冲周期
  368          //-------------------------------------------------------------------------------------------------------
             -------------
  369          static uint8 dl1a_get_vcsel_pulse_period (dl1a_vcsel_period_type_enum type)
  370          {
  371   1          uint8 data_buffer = 0;
  372   1          
  373   1          if(DL1A_VCSEL_PERIOD_PER_RANGE == type)
  374   1          {
  375   2              dl1a_read_registers(DL1A_PRE_RANGE_CONFIG_VCSEL_PERIOD, &data_buffer, 1);
  376   2              data_buffer = decode_vcsel_period(data_buffer);
  377   2          }
  378   1          else if(DL1A_VCSEL_PERIOD_FINAL_RANGE == type)
  379   1          {
  380   2              dl1a_read_registers(DL1A_FINAL_RANGE_CONFIG_VCSEL_PERIOD, &data_buffer, 1);
  381   2              data_buffer = decode_vcsel_period(data_buffer);
  382   2          }
  383   1          else
  384   1          {
  385   2              data_buffer = 255;
  386   2          }
  387   1          
  388   1          return data_buffer;
  389   1      }
