  429          //-------------------------------------------------------------------------------------------------------
             -------------
  430          // 函数简介     执行单次参考校准
  431          // 参数说明     vhv_init_byte   预设校准值
  432          // 返回参数     uint8           操作是否成功 0-成功 1-失败
  433          // 使用示例     dl1a_get_vcsel_pulse_period(DL1A_VCSEL_PERIOD_PER_RANGE);
  434          // 备注信息     在 PCLKs 中获取给定周期类型的 VCSEL 脉冲周期
  435          //-------------------------------------------------------------------------------------------------------
             -------------
  436          static uint8 dl1a_perform_single_ref_calibration (uint8 vhv_init_byte)
  437          {
  438   1          uint8 return_state = 0;
  439   1          uint8 data_buffer = 0;
  440   1          volatile uint16 loop_count = 0;
  441   1          
  442   1          do
  443   1          {
  444   2              dl1a_write_register(DL1A_SYSRANGE_START, 0x01 | vhv_init_byte);
  445   2              dl1a_read_registers(DL1A_MSRC_CONFIG_TIMEOUT_MACROP, &data_buffer, 1);
  446   2              
  447   2              while(0 == (data_buffer & 0x07))
  448   2              {
  449   3                  system_delay_ms(1);
  450   3                  dl1a_read_registers(DL1A_MSRC_CONFIG_TIMEOUT_MACROP, &data_buffer, 1);
  451   3                  
  452   3                  if(DL1A_TIMEOUT_COUNT < loop_count ++)
  453   3                  {
  454   4                      return_state = 1;
  455   4                      break;
  456   4                  }
  457   3              }
  458   2              
  459   2              if(return_state)
  460   2              {
  461   3                  break;
  462   3              }
  463   2              
  464   2              dl1a_write_register(DL1A_SYSTEM_INTERRUPT_CLEAR, 0x01);
  465   2              dl1a_write_register(DL1A_SYSRANGE_START, 0x00);
  466   2          }
  467   1          while(0);
  468   1          
  469   1          return return_state;
  470   1      }
