  397          // 备注信息     获取所有超时而不仅仅是请求的超时 并且还存储中间值
  398          //-------------------------------------------------------------------------------------------------------
             -------------
  399          static void dl1a_get_sequence_step_timeouts (dl1a_sequence_enables_step_struct const *enables, dl1a_seque
             -nce_timeout_step_struct *timeouts)
  400          {
  401   1          uint8 reg_buffer[2];
  402   1          uint16 reg16_buffer = 0;
  403   1          
  404   1          timeouts->pre_range_vcsel_period_pclks = dl1a_get_vcsel_pulse_period(DL1A_VCSEL_PERIOD_PER_RANGE);
  405   1          
