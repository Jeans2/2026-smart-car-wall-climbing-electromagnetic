  197          //-------------------------------------------------------------------------------------------------------
             -------------
  198          // 函数简介     获取设备 SPAD 信息
  199          // 参数说明     index           索引
  200          // 参数说明     type            类型值
  201          // 返回参数     uint8           是否成功 0-成功 1-失败
  202          // 使用示例     dl1a_get_spad_info(index, type_is_aperture);
  203          // 备注信息
  204          //-------------------------------------------------------------------------------------------------------
             -------------
  205          static uint8 dl1a_get_spad_info (uint8 *index, uint8 *type_is_aperture)
  206          {
  207   1          uint8 tmp = 0;
  208   1          uint8 return_state = 0;
  209   1          volatile uint16 loop_count = 0;
  210   1          
  211   1          do
  212   1          {
  213   2              dl1a_write_register(0x80, 0x01);
  214   2              dl1a_write_register(0xFF, 0x01);
  215   2              dl1a_write_register(0x00, 0x00);
  216   2              
  217   2              dl1a_write_register(0xFF, 0x06);
  218   2              dl1a_read_registers(0x83, &tmp, 1);
  219   2              dl1a_write_register(0x83, tmp | 0x04);
  220   2              dl1a_write_register(0xFF, 0x07);
  221   2              dl1a_write_register(0x81, 0x01);
  222   2              
  223   2              dl1a_write_register(0x80, 0x01);
  224   2              
  225   2              dl1a_write_register(0x94, 0x6b);
  226   2              dl1a_write_register(0x83, 0x00);
  227   2              
  228   2              tmp = 0x00;
  229   2              
  230   2              while(0x00 == tmp || 0xFF == tmp)
  231   2              {
  232   3                  system_delay_ms(1);
  233   3                  dl1a_read_registers(0x83, &tmp, 1);
  234   3                  
  235   3                  if(DL1A_TIMEOUT_COUNT < loop_count ++)
  236   3                  {
  237   4                      return_state = 1;
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/05/26  17:37:24  PAGE 5   

  238   4                      break;
  239   4                  }
  240   3                  
  241   3              }
  242   2              
  243   2              if(return_state)
  244   2              {
  245   3                  break;
  246   3              }
  247   2              
  248   2              dl1a_write_register(0x83, 0x01);
  249   2              dl1a_read_registers(0x92, &tmp, 1);
  250   2              
  251   2              *index = tmp & 0x7f;
  252   2              *type_is_aperture = (tmp >> 7) & 0x01;
  253   2              
  254   2              dl1a_write_register(0x81, 0x00);
  255   2              dl1a_write_register(0xFF, 0x06);
  256   2              dl1a_read_registers(0x83, &tmp, 1);
  257   2              dl1a_write_register(0x83, tmp);
  258   2              dl1a_write_register(0xFF, 0x01);
  259   2              dl1a_write_register(0x00, 0x01);
  260   2              
  261   2              dl1a_write_register(0xFF, 0x00);
  262   2              dl1a_write_register(0x80, 0x00);
  263   2          }
  264   1          while(0);
  265   1          
  266   1          return return_state;
  267   1      }
  268          
  269          //-------------------------------------------------------------------------------------------------------
             -------------
  270          // 函数简介     将超时数值从 MCLKs 转换到对应的 ms
  271          // 参数说明     timeout_period_mclks    超时周期 MCLKs
  272          // 参数说明     vcsel_period_pclks      PCLK 值
  273          // 返回参数     uint32                  返回超时数值
  274          // 使用示例     dl1a_timeout_mclks_to_microseconds(timeout_period_mclks, vcsel_period_pclks);
  275          // 备注信息     将序列步骤超时从具有给定 VCSEL 周期的 MCLK (以 PCLK 为单位)转换�
             -��微秒
  276          //-------------------------------------------------------------------------------------------------------
             -------------
  277          static uint32 dl1a_timeout_mclks_to_microseconds (uint16 timeout_period_mclks, uint8 vcsel_period_pclks)
  278          {
  279   1          uint32 macro_period_ns = calc_macro_period(vcsel_period_pclks);
  280   1          
  281   1          return ((timeout_period_mclks * macro_period_ns) + (macro_period_ns / 2)) / 1000;
  282   1      }
  283          
  284          //-------------------------------------------------------------------------------------------------------
             -------------
  285          // 函数简介     将超时数值从 ms 转换到对应的 MCLKs
  286          // 参数说明     timeout_period_us   超时周期 微秒单位
  287          // 参数说明     vcsel_period_pclks  PCLK 值
  288          // 返回参数     uint32              返回超时数值
  289          // 使用示例     dl1a_timeout_microseconds_to_mclks(timeout_period_us, vcsel_period_pclks);
  290          // 备注信息     将序列步骤超时从微秒转换为具有给定 VCSEL 周期的 MCLK (以 PCLK �
             -�单位)
  291          //-------------------------------------------------------------------------------------------------------
             -------------
  292          static uint32 dl1a_timeout_microseconds_to_mclks (uint32 timeout_period_us, uint8 vcsel_period_pclks)
  293          {
  294   1          uint32 macro_period_ns = calc_macro_period(vcsel_period_pclks);
  295   1          
  296   1          return (((timeout_period_us * 1000) + (macro_period_ns / 2)) / macro_period_ns);
  297   1      }
