  472          //-------------------------------------------------------------------------------------------------------
             -------------
  473          // 函数简介     设置测量定时预算 (以微秒为单位)
  474          // 参数说明     budget_us       设定的测量允许的时间
  475          // 返回参数     uint8           操作结果 0-成功 1-失败
  476          // 使用示例     dl1a_set_measurement_timing_budget(measurement_timing_budget_us);
  477          // 备注信息     这是一次测量允许的时间
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/05/26  17:37:24  PAGE 9   

  478          //              即在测距序列的子步骤之间分配时间预算
  479          //              更长的时间预算允许更精确的测量
  480          //              增加一个N倍的预算可以减少一个sqrt(N)倍的范围测量标准偏差
  481          //              默认为33毫秒 最小值为20 ms
  482          //-------------------------------------------------------------------------------------------------------
             -------------
  483          static uint8 dl1a_set_measurement_timing_budget (uint32 budget_us)
  484          {
  485   1          uint8 return_state = 0;
  486   1          uint8 data_buffer[3];
  487   1          uint16 dat = 0;
  488   1          
  489   1          uint32 final_range_timeout_us = 0;
  490   1          uint16 final_range_timeout_mclks = 0;
  491   1          
  492   1          dl1a_sequence_enables_step_struct enables;
  493   1          dl1a_sequence_timeout_step_struct timeouts;
  494   1          
  495   1          do
  496   1          {
  497   2              uint32 used_budget_us = DL1A_SET_START_OVERHEAD + DL1A_END_OVERHEAD;
  498   2              
  499   2              if(DL1A_MIN_TIMING_BUDGET > budget_us)
  500   2              {
  501   3                  return_state = 1;
  502   3                  break;
  503   3              }
  504   2              
  505   2              dl1a_get_sequence_step_enables(&enables);
  506   2              dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  507   2              
  508   2              if(enables.tcc)
  509   2              {
  510   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  511   3              }
  512   2              
  513   2              if(enables.dss)
  514   2              {
  515   3                  used_budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  516   3              }
  517   2              else if(enables.msrc)
  518   2              {
  519   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  520   3              }
  521   2              
  522   2              if(enables.pre_range)
  523   2              {
  524   3                  used_budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  525   3              }
  526   2              
  527   2              if(enables.final_range)
  528   2              {
  529   3                  // 请注意 最终范围超时由计时预算和序列中所有其他超时的总和决定
  530   3                  // 如果没有空间用于最终范围超时 则将设置错误
  531   3                  // 否则 剩余时间将应用于最终范围
  532   3                  used_budget_us += DL1A_FINALlRANGE_OVERHEAD;
  533   3                  
  534   3                  if(used_budget_us > budget_us)
  535   3                  {
  536   4                      // 请求的超时太大
  537   4                      return_state = 1;
  538   4                      break;
  539   4                  }
  540   3                  
  541   3                  // 对于最终超时范围 必须添加预量程范围超时
  542   3                  // 为此 最终超时和预量程超时必须以宏周期 MClks 表示
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/05/26  17:37:24  PAGE 10  

  543   3                  // 因为它们具有不同的 VCSEL 周期
  544   3                  final_range_timeout_us = budget_us - used_budget_us;
  545   3                  final_range_timeout_mclks =
  546   3                      (uint16)dl1a_timeout_microseconds_to_mclks(final_range_timeout_us,
  547   3                          (uint8)timeouts.final_range_vcsel_period_pclks);
  548   3                          
  549   3                  if(enables.pre_range)
  550   3                  {
  551   4                      final_range_timeout_mclks += timeouts.pre_range_mclks;
  552   4                  }
  553   3                  
  554   3                  dat = dl1a_encode_timeout(final_range_timeout_mclks);
  555   3                  data_buffer[0] = DL1A_FINAL_RANGE_CONFIG_TIMEOUT_MACROP_HI;
  556   3                  data_buffer[1] = ((dat >> 8) & 0xFF);
  557   3                  data_buffer[2] = (dat & 0xFF);
  558   3                  dl1a_write_array(data_buffer, 3);
  559   3              }
  560   2          }
  561   1          while(0);
  562   1          
  563   1          return return_state;
  564   1      }
