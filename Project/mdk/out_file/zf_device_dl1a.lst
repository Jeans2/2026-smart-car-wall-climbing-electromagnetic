  299          //-------------------------------------------------------------------------------------------------------
             -------------
  300          // 函数简介     对超时数值进行解码
  301          // 参数说明     reg_val         超时时长 寄存器值
  302          // 返回参数     uint16          返回超时数值
  303          // 使用示例     dl1a_decode_timeout(reg_val);
  304          // 备注信息     从寄存器值解码 MCLK 中的序列步骤超时
  305          //-------------------------------------------------------------------------------------------------------
             -------------
  306          static uint16 dl1a_decode_timeout (uint16 reg_val)
  307          {
  308   1          // 格式: (LSByte * 2 ^ MSByte) + 1
  309   1          return  (uint16)((reg_val & 0x00FF) <<
  310   1                           (uint16)((reg_val & 0xFF00) >> 8)) + 1;
  311   1      }
  312          
  313          //-------------------------------------------------------------------------------------------------------
             -------------
  314          // 函数简介     对超时数值进行编码
  315          // 参数说明     timeout_mclks   超时时长 -MCLKs 值
  316          // 返回参数     uint16          返回编码值
  317          // 使用示例     dl1a_encode_timeout(timeout_mclks);
  318          // 备注信息     在 MCLK 中对超时的序列步骤超时寄存器值进行编码
  319          //-------------------------------------------------------------------------------------------------------
             -------------
  320          static uint16 dl1a_encode_timeout (uint16 timeout_mclks)
  321          {
  322   1          uint32 edata ls_byte = 0;
  323   1          uint16 edata ms_byte = 0;
  324   1          uint16 edata return_data = 0;
  325   1          
  326   1          if (timeout_mclks > 0)
  327   1          {
  328   2              // 格式: (LSByte * 2 ^ MSByte) + 1
  329   2              ls_byte = timeout_mclks - 1;
  330   2              
  331   2              while ((ls_byte & 0xFFFFFF00) > 0)
  332   2              {
  333   3                  ls_byte >>= 1;
  334   3                  ms_byte++;
  335   3              }
  336   2              
  337   2              return_data = (ms_byte << 8) | (ls_byte & 0xFF);
  338   2          }
  339   1          
  340   1          return return_data;
  341   1      }
  342          
