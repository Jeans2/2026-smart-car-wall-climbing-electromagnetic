  612          // 函数简介     设置返回信号速率限制 该值单位为 MCPS (百万次每秒)
  613          // 参数说明     limit_mcps      设置的最小速率
  614          // 返回参数     void
  615          // 使用示例     dl1a_set_signal_rate_limit(0.25);
  616          // 备注信息     这个速率表示从目标反射并被设备检测到的信号的振幅
  617          //              设置此限制可以确定传感器报告有效读数所需的最小测量值
  618          //              设置一个较低的限制可以增加传感器的测量范围
  619          //              但似乎也增加了 <由于来自目标以外的物体的不需要的反射导致> 得�
             -��不准确读数的可能性
  620          //              默认为 0.25 MCPS 可预设范围为 0 - 511.99
  621          //-------------------------------------------------------------------------------------------------------
             -------------
  622          static void dl1a_set_signal_rate_limit (float limit_mcps)
  623          {
  624   1          uint8 data_buffer[3];
  625   1          uint16 limit_mcps_16bit = (uint16)(limit_mcps * (1 << 7));
  626   1          
  627   1          zf_assert(0 <= limit_mcps || 511.99 >= limit_mcps);
  628   1          
  629   1          data_buffer[0] = DL1A_FINAL_RANGE_CONFIG_MIN_COUNT_RATE_RTN_LIMIT;
  630   1          data_buffer[1] = ((limit_mcps_16bit >> 8) & 0xFF);
  631   1          data_buffer[2] = (limit_mcps_16bit & 0xFF);
  632   1          
  633   1          dl1a_write_array(data_buffer, 3);
  634   1      }
