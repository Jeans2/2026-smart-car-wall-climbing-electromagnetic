  350          static void dl1a_get_sequence_step_enables(dl1a_sequence_enables_step_struct *enables)
  351          {
  352   1          uint8 sequence_config = 0;
  353   1          dl1a_read_registers(DL1A_SYSTEM_SEQUENCE_CONFIG, &sequence_config, 1);
  354   1          
  355   1          enables->tcc          = (sequence_config >> 4) & 0x1;
  356   1          enables->dss          = (sequence_config >> 3) & 0x1;
  357   1          enables->msrc         = (sequence_config >> 2) & 0x1;
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/05/26  17:37:24  PAGE 7   

  358   1          enables->pre_range    = (sequence_config >> 6) & 0x1;
  359   1          enables->final_range  = (sequence_config >> 7) & 0x1;
  360   1      }
