                 // 函数简介     ICM20602 写寄存器
                 // 参数说明     reg             寄存器地址
                 // 参数说明     data            数据
                 // 返回参数     void
                 // 使用示例     icm20602_write_register(ICM20602_PWR_MGMT_1, 0x80);
                 // 备注信息     内部调用
                 //------------------------------------------------------------------------------------------------------
             --------------
                 static void icm20602_write_register (uint8 reg, uint8 dat)
                 {
                   ICM20602_CS(0);
                   spi_write_8bit_register(ICM20602_SPI, reg | ICM20602_SPI_W, dat);
                   ICM20602_CS(1);
                 }
               
                 //------------------------------------------------------------------------------------------------------
             --------------
                 // 函数简介     ICM20602 读寄存器
