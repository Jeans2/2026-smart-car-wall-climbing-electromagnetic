  125            //------------------------------------------------------------------------------------------------------
             --------------
  126            //  @brief      通过SPI写一个byte,同时读取一个byte
  127            //  @param      byte        发送的数据
  128            //  @return     uint8 edata       return 返回status状态
  129            //  @since      v1.0
  130            //  Sample usage:
  131            //------------------------------------------------------------------------------------------------------
             --------------
  132            static uint8 icm20602_simspi_wr_byte(uint8 byte)
  133            {
  134   1          uint8 i;
  135   1          for(i=0; i<8; i++)
  136   1          {
  137   2            ICM20602_SCK (0);
  138   2            ICM20602_MOSI(byte&0x80);
  139   2            byte <<= 1;
  140   2            ICM20602_SCK (1);
  141   2            byte |= ICM20602_MISO;
  142   2          }
  143   1          return(byte);
  144   1        }
  145            
