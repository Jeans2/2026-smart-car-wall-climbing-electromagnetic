                 // 备注信息     内部调用
                 //------------------------------------------------------------------------------------------------------
             --------------
                 static uint8 icm20602_read_register (uint8 reg)
                 {
                   uint8 dat = 0;
                   ICM20602_CS(0);
                   dat = spi_read_8bit_register(ICM20602_SPI, reg | ICM20602_SPI_R);
                   ICM20602_CS(1);
                   return dat;
                 }
               
