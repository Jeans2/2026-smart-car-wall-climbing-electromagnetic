                 static void imu660ra_write_register(uint8 reg, uint8 dat)
                 {
                   IMU660RA_CS(0);
                   spi_write_8bit_register(IMU660RA_SPI, reg | IMU660RA_SPI_W, dat);
                   IMU660RA_CS(1);
                 }
               
