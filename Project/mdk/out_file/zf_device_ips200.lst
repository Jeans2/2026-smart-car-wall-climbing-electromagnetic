             -的 示例
  513          // 备注信息                        使用PCtoLCD2002软件取模           阴码、逐行式、顺�
             -�   16*16
  514          //-------------------------------------------------------------------------------------------------------
             -------------
  515          void ips200_show_chinese (uint16 x, uint16 y, uint8 siz, const uint8 *p, uint8 number, uint16 color)
  516          {
  517   1        int i, j, k; 
  518   1          uint8 temp, temp1, temp2;
  519   1          const uint8 *p_data;
  520   1        
  521   1          zf_assert(x < ips200_x_max);
  522   1          zf_assert(y < ips200_y_max);
  523   1      
  524   1          temp2 = siz/8;
  525   1          
  526   1          ips200_set_region(x,y,number*siz-1+x,y+siz-1);
C251 COMPILER V5.60.0,  zf_device_ips200                                                   19/01/26  01:07:46  PAGE 10  

  527   1          
  528   1          for(i=0;i<siz;i++)
  529   1          {
  530   2              temp1 = number;
  531   2              p_data = p+i*temp2;
  532   2              while(temp1--)
  533   2              {
  534   3                  for(k=0;k<temp2;k++)
  535   3                  {
  536   4                      for(j=8;j>0;j--)
  537   4                      {
  538   5                          temp = (*p_data>>(j-1)) & 0x01;
  539   5                          if(temp)    ips200_write_16bit_data(color);
  540   5                          else        ips200_write_16bit_data(ips200_bgcolor);
  541   5                      }
  542   4                      p_data++;
  543   4                  }
  544   3                  p_data = p_data - temp2 + temp2*siz;
  545   3              }   
  546   2          }
  547   1      }
