  497   2              width_index = i*width/dis_width;
  498   2              value_max_index = *(p+width_index)*(dis_value_max-1)/value_max;
  499   2              ips200_draw_point(i+x, (dis_value_max-1)-value_max_index+y, ips200_pencolor);
  500   2          }
  501   1      }
