  417          // 参数说明       x               坐标x方向的起点 参数范围 [0, ips200_x_max-1]
  418          // 参数说明       y               坐标y方向的起点 参数范围 [0, ips200_y_max-1]
  419          // 参数说明       dat             需要显示的变量，数据类型float或double
  420          // 参数说明       num             整数位显示长度   最高10位
  421          // 参数说明       pointnum        小数位显示长度   最高6位
  422          // 返回参数      void
  423          // 使用示例                ips200_showfloat(0,0,x,2,3);                    // 显示浮点数   整�
             -�显示2位   小数显示三位
  424          // @note                        特别注意当发现小数部分显示的值与你写入的值不一样�
             -��时候，
  425          //                              可能是由于浮点数精度丢失问题导致的，这并不是显示�
             -��数的问题，
  426          //                              有关问题的详情，请自行百度学习   浮点数精度丢失问�
             -��。
  427          //                              负数会显示一个 ‘-’号   正数显示一个空格
  428          //-------------------------------------------------------------------------------------------------------
             -------------
  429          void ips200_show_float(uint16 x,uint16 y,double dat,uint8 num,uint8 pointnum)
  430          {
  431   1          uint8   length;
  432   1          int8    buff[34];
  433   1          int8    start,end,point;
  434   1        
  435   1          zf_assert(x < ips200_x_max);
  436   1          zf_assert(y < ips200_y_max);
  437   1      
  438   1          if(6<pointnum)  pointnum = 6;
  439   1          if(10<num)      num = 10;
  440   1              
  441   1          if(0>dat)   length = zf_sprintf( &buff[0],(const int8 *)"%f",dat);        // 负数
  442   1          else
  443   1          {
  444   2              length = zf_sprintf( &buff[1],(const int8 *)"%f",dat);
  445   2              length++;
  446   2          }
  447   1          point = length - 7;                                                         // 计算小数点位置
  448   1          start = point - num - 1;                                                    // 计算起始位
  449   1          end = point + pointnum + 1;                                                 // 计算结束位
  450   1          while(0>start)                                                              // 整数位不够  末�
             -�应该填充空格
  451   1          {
  452   2              buff[end] = ' ';
  453   2              end++;
  454   2              start++;
  455   2          }
  456   1          
  457   1          if(0>dat)   buff[start] = '-';
  458   1          else        buff[start] = ' ';
  459   1          
  460   1          buff[end] = '\0';
  461   1      
  462   1          ips200_show_string(x, y, (const char *)buff);                               // 显示数字
  463   1      }
