  275   2                  speed_target = speed_ringR;
  276   2                  target_L = speed_target + correct_L; 
  277   2                  target_R = speed_target - correct_L;
  278   2                  break;
  279   2              
  280   2              case 4: // 4-直线出岛 (原case 5，锁死两轮相同速度直线跑开)
