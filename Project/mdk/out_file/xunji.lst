  129          //环岛状态判断
  130          void ringR_task(void)
  131          {
  132   1          switch(ringR_flag_task)
  133   1          {
  134   2              case 1:                                     // 1-准备进岛
  135   2                  ring_flag_ing = 200;                    // 进入环岛状态
  136   2                  ringR_flag_execute = 1;
  137   2                  distance_ringR += speed_avl;
  138   2                  if(distance_ringR > distance_ringR_1)   // 到达打角点
  139   2                  {   
  140   3                      angle_clear();                      // 到达打角点，角度清零
  141   3                      distance_ringR = 0;
  142   3                      ringR_flag_task = 2;
  143   3                      ringR_flag_execute = 2; 
  144   3                  }
  145   2                  break;
  146   2                  
  147   2              case 2:                                     // 2-进岛打角角度积分
  148   2                  if(angle > 30)                          // 打角完成
  149   2                  {
  150   3                      ringR_flag_task = 3;
  151   3                      ringR_flag_execute = 3;
  152   3                  }
  153   2                  break;
  154   2                          
  155   2              case 3:                                     // 3-岛内电磁循迹角度积分       
  156   2                 
  157   2                  if(angle > 300)                         // 到达出环角度，直接触发直行出岛
  158   2                  {                           
  159   3                      ringR_flag_task = 4;
  160   3                      ringR_flag_execute = 4;
  161   3                  }
  162   2                  break;
  163   2                              
  164   2              case 4:                                     // 4-直线出岛 (原case 5)
  165   2                  distance_ringR += speed_avl;
  166   2                  if(distance_ringR > 8000)               // 跑出足够距离，完全出岛
  167   2                  {   
  168   3                      angle_clear();
  169   3                      distance_ringR = 0;
  170   3                      ringR_flag_task = 1;
  171   3                      ringR_flag_execute = 1;
  172   3                      element = 0;                        // 元素清零
  173   3                  }
  174   2                  break;
  175   2                                      
  176   2              default:
  177   2                  break;  
  178   2          }
  179   1      }
