  114   3                   
  115   3                    distance_ringR = 0;
  116   3                    ringR_flag_task = 0;
  117   3                    ringR_flag_execute = 1;
  118   3                    element = 0;   
  119   3                    gpio_set_level(IO_P52, 1);
  120   3                }
  121   2                break;
  122   2                                      
  123   2              default:
