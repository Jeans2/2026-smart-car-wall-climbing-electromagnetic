  256   1          float target_R = 0;
  257   1          
  258   1          switch(ringR_flag_execute)
  259   1          {
  260   2              case 1: // 1-直线进岛 
  261   2                  speed_target = speed_ringR;
  262   2                  target_L = speed_target;
  263   2                  target_R = speed_target;        
  264   2                  break;
  265   2              
  266   2              case 2: // 2-打角进岛 
  267   2                  // 左轮加速推，右轮减速拉。
  268   2                  speed_target = speed_ringR;
  269   2                  target_L = speed_target + 50; 
  270   2                  target_R = speed_target - 30;
  271   2                  break;
  272   2              
  273   2              case 3: // 3-岛内电磁巡线
