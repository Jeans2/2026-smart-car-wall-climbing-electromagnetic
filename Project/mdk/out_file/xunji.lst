   98          // 3. 循迹速度执行
   99          void xunji() 
  100          {
  101   1           turnspeed = (int16)out(); // 获取正常PID输出
  102   1       
  103   1          if (huan_flag == 1) 
  104   1          {
  105   2              switch (cur_state) {
  106   3                  case ROUND_IN: // 入环：强制差速（不管传感器）
  107   3                      if (direct_l == 1) { // 左转：右轮快，左轮慢
  108   4                          correct_speed_L = speed_target - 40;
  109   4                          correct_speed_R = speed_target + 40;
  110   4                      } else { // 右转：左轮快，右轮慢
  111   4                          correct_speed_L = speed_target + 15;
  112   4                          correct_speed_R = speed_target - 15;
  113   4                      }
  114   3                      break;
  115   3      
  116   3                  case ROUND_KEEP: // 环内：高增益循迹
  117   3                      correct_speed_L = speed_target - turnspeed * 1.2f-10;
  118   3                      correct_speed_R = speed_target + turnspeed * 1.2f+10;
  119   3                      break;
  120   3      
  121   3                  case ROUND_PREOUT: // 出环：低增益 + 强制回正力
  122   3                      // 假设出环时给一个向外的固定补偿 (5)
  123   3                      if (direct_l == 1) {
