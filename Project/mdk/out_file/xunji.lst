  282   2                  target_L = speed_target;
  283   2                  target_R = speed_target;
  284   2                  break;
  285   2              
  286   2              default:
  287   2                  break;
  288   2          }
  289   1      
  290   1          if(ringR_flag_execute != 0)
  291   1          {
  292   2              // 只有在环岛状态时，才执行环岛的速度分配
  293   2              speed_loop_LR(target_L, target_R);
  294   2              set_pwm_motor_R(out_R);
  295   2              set_pwm_motor_L(out_L);
  296   2          }
  297   1      }
