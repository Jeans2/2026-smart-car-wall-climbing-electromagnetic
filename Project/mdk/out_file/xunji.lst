  104   3                    distance_ringR = 0;
  105   3                   gpio_set_level(IO_P52, 0);
  106   3                 }
  107   2                 break;
  108   2                              
  109   2              case 4:                                     
  110   2                  
  111   2                distance_ringR += speed_avl;
  112   2                if(distance_ringR > 22000)               
