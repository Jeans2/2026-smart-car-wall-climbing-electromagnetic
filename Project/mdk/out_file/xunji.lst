  110          //环岛状态判断
  111          void ringR_task(void)
  112          {
  113   1          switch(ringR_flag_task)
  114   1          {
  115   2                        
  116   2              case 1:  
  117   2                                               
  118   2                angle_get();
  119   2                if(angle < -280)                        
  120   2                 {                           
  121   3                     ringR_flag_task = 4;                                               
  122   3                     ringR_flag_execute = 4;
  123   3                    distance_ringR = 0;
