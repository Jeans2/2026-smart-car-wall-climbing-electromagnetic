  124   3                   gpio_set_level(IO_P52, 0);
  125   3                 }
  126   2                 break;
  127   2                              
  128   2              case 4:                                     
  129   2                  
  130   2                distance_ringR += speed_avl;
  131   2                if(distance_ringR > 18000)               
  132   2                {   
  133   3                   
  134   3                    distance_ringR = 0;
  135   3                    ringR_flag_task = 0;
  136   3                    ringR_flag_execute = 1;
  137   3                    element = 0;   
  138   3                    gpio_set_level(IO_P52, 1);
  139   3                }
  140   2                break;
  141   2                                      
  142   2              default:
  143   2                break;  
  144   2          }
  145   1      }
