   58          // 2. 环岛状态机切换（基于角度绝对值）
   59          void benhuan() {
   60   1          if (huan_flag == 0) 
   61   1          {
   62   2            return;
   63   2          } 
   64   1          
   65   1      
   66   1           abs_angle = fabs(angle); // 统一绝对值，不管左旋右旋
   67   1      
   68   1          switch (cur_state) 
   69   1          {
   70   2              case ROUND_IN:
   71   2                  if (abs_angle >= HUAN_ANGLE_IN) {
   72   3                      cur_state = ROUND_KEEP; // 角度够了，立刻变更为环内循迹
   73   3                  }
   74   2                  break;
   75   2      
   76   2              case ROUND_KEEP:
   77   2                  if (abs_angle >= HUAN_ANGLE_OUT) {
   78   3                      cur_state = ROUND_PREOUT; // 准备出环
   79   3                  }
   80   2                  break;
   81   2      
   82   2              case ROUND_PREOUT:
   83   2                  // 出环判定：中间两个电感重新找回直道特征，或侧边电感离开圆弧
   84   2                  if (abs(LM - RM) < 40) { 
   85   3                      cur_state = ROUND_EXIT;
   86   3                  }
   87   2                  break;
   88   2      
   89   2              case ROUND_EXIT:
   90   2                  huan_init(); // 重置所有参数
   91   2                  huan_cooldown = 500; // 设置冷却，防止出环瞬间误触发
   92   2                  break;
   93   2                  
   94   2              default: break;
   95   2          }
   96   1      }
