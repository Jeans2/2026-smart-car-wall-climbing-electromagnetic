   61          //滑动平均滤波 初始化
   62          void initSlidingAverage(SlidingAverageFilter* filter, int N) {
   63   1         uint8 Win_i=0;
   64   1          if (N > MAX_WINDOW_SIZE) {
   65   2              N = MAX_WINDOW_SIZE; // 限制窗口大小不能超过最大值
   66   2          }
   67   1      
   68   1          for (Win_i = 0; Win_i < MAX_WINDOW_SIZE; Win_i++) {
   69   2              filter->buffer[Win_i] = 0.0f;
   70   2          }
   71   1          filter->sum = 0.0f;
   72   1          filter->index = 0;
   73   1          filter->count = 0;
   74   1          filter->window_size = N;
   75   1        }   
   76          //滑动平均滤波
   77          void slidingAverage(float now_speed, float* avg_speed, SlidingAverageFilter* filter) {
   78   1          // 从和中减去即将被替换的旧值
   79   1          filter->sum -= filter->buffer[filter->index];
   80   1      
   81   1          // 将新的值插入缓冲区
   82   1          filter->buffer[filter->index] = now_speed;
   83   1      
   84   1          // 更新和
   85   1          filter->sum += now_speed;
   86   1      
   87   1          // 更新索引，使其循环回到起始位置
   88   1          filter->index = (filter->index + 1) % filter->window_size;
   89   1      
   90   1          // 如果窗口没有满，增加计数
   91   1          if (filter->count < filter->window_size) {
   92   2              filter->count++;
   93   2          }
   94   1      
   95   1          // 计算并返回当前窗口的平均值
   96   1          *avg_speed = filter->sum / filter->count;
   97   1      }
