  156          //========================================================================
  157          // 速度环（内环）
  158          //========================================================================
  159          void speed_loop_LR(int16 speed_L_t,int16 speed_R_t)
  160          {
  161   1        //0-编码器输入更新
  162   1        static int16 err_speed_L_last=0,err_speed_L=0;
  163   1        static float speed_output_L=0;
  164   1        static int16 err_speed_R_last=0,err_speed_R=0;
  165   1        static float speed_output_R=0;
  166   1        
  167   1        //1-误差计算
  168   1        err_speed_L_last = err_speed_L;
  169   1        err_speed_L = speed_L_t - speed_L;
  170   1        
  171   1        //2-控制
  172   1        speed_output_L = pid_loop_speed.Kp * (err_speed_L - err_speed_L_last)
  173   1                          + pid_loop_speed.Ki * err_speed_L;
  174   1      
  175   1        //增量
  176   1        if(speed_output_L>2000 ){speed_output_L=2000; }
  177   1        if(speed_output_L<-2000){speed_output_L=-2000;}
  178   1        
  179   1        //输出
  180   1        out_L += speed_output_L;
  181   1        
  182   1        
  183   1        
  184   1        //0-编码器输入更新
  185   1        
  186   1        //1-误差计算
  187   1        err_speed_R_last = err_speed_R;
  188   1        err_speed_R = speed_R_t - speed_R;
  189   1        
