   14          //直行速度环
   15          void speed_loop(void)
   16          {
   17   1          static int16 last_err_speed=0;
   18   1          static int16 last_last_err_speed=0;
   19   1          static float speed_output=0;//总输出
   20   1        //1-误差计算
   21   1         last_last_err_speed = last_err_speed;
   22   1         last_err_speed = err_speed; 
   23   1         err_speed = speed_target - speed_L;
   24   1        
   25   1      //2—增量式PI控制
   26   1          speed_output =  pid_loop_speed.Kp * (err_speed - last_err_speed)
   27   1                        + pid_loop_speed.Ki *  err_speed 
   28   1                        + pid_loop_speed.Kd * (err_speed - 2*last_err_speed + last_last_err_speed);
   29   1        
   30   1        //增量
   31   1        if(speed_output>2000 ){speed_output=2000; }
   32   1        if(speed_output<-2000){speed_output=-2000;}
   33   1        
   34   1        //输出
   35   1        out_L+= speed_output;
   36   1        //out_R = out_L;
   37   1        
   38   1        if(out_L>5000 ){out_L=5000; }
   39   1        if(out_L<-5000){out_L=-5000;}
   40   1        if(out_R>5000 ){out_R=5000; }
   41   1        if(out_R<-5000){out_R=-5000;} 
   42   1      }
