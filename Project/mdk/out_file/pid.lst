   72          //========================================================================
   73          // 速度环（内环）
   74          //========================================================================
   75          void speed_loop_LR(int16 speed_L_t,int16 speed_R_t)
   76          {
   77   1        //0-编码器输入更新
   78   1        static int16 err_speed_L_last=0,err_speed_L=0;
   79   1        static float speed_output_L=0;
   80   1        static int16 err_speed_R_last=0,err_speed_R=0;
   81   1        static float speed_output_R=0;
   82   1        
   83   1        //1-误差计算
   84   1        err_speed_L_last = err_speed_L;
   85   1        err_speed_L = speed_L_t - speed_L;
   86   1        
   87   1        
   88   1        
   89   1        //2-控制
   90   1        speed_output_L = pid_loop_speed.Kp * (err_speed_L - err_speed_L_last)
   91   1                          + pid_loop_speed.Ki * err_speed_L;
   92   1      
   93   1        //增量
   94   1        if(speed_output_L>2000 ){speed_output_L=2000; }
   95   1        if(speed_output_L<-2000){speed_output_L=-2000;}
   96   1        
   97   1        //输出
   98   1        out_L += speed_output_L;
   99   1        
  100   1        
  101   1        
  102   1        //0-编码器输入更新
  103   1        
  104   1        //1-误差计算
  105   1        err_speed_R_last = err_speed_R;
  106   1        err_speed_R = speed_R_t - speed_R;
  107   1        
  108   1        //2-控制
  109   1        speed_output_R =  pid_loop_speed.Kp * (err_speed_R - err_speed_R_last)
  110   1                          + pid_loop_speed.Ki *  err_speed_R;
  111   1      
  112   1        //增量
  113   1        if(speed_output_R>2000 ){speed_output_R=2000; }
  114   1        if(speed_output_R<-2000){speed_output_R=-2000;}
  115   1        
  116   1        //输出
  117   1        out_R += speed_output_R;
  118   1        
  119   1        if(out_L>3500 ){out_L=3500; }
  120   1        if(out_L<-3500){out_L=-3500;}
  121   1        if(out_R>3500 ){out_R=3500; }
  122   1        if(out_R<-3500){out_R=-3500;}
  123   1      }
