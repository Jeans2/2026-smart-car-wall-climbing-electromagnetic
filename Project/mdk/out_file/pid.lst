  210          //========================================================================
  211          // 角速度环 （中环）- 输入角速度期望，输出电机差速修正值
  212          //========================================================================
  213          float gyro_loop(float expect_gyro, float avl_gyro_z)
  214          {
  215   1          float err_gyro;
  216   1          
  217   1          // 计算角速度误差
  218   1          err_gyro = expect_gyro - avl_gyro_z;
  219   1          
  220   1          // 更新误差数组
  221   1          direction_err2[1] = direction_err2[0];
  222   1          direction_err2[0] = err_gyro;
  223   1      
  224   1          // PD控制器计算修正量
  225   1          correct_L = pid_motor_run.Kp_gyro * direction_err2[0]
  226   1                    + pid_motor_run.Kd_gyro * (direction_err2[0] - direction_err2[1]);
  227   1          
  228   1          // 限幅
  229   1          if(correct_L > 10000) correct_L = 10000;
  230   1          if(correct_L < -10000) correct_L = -10000;
  231   1          
  232   1          return correct_L;  // 返回电机差速修正值
  233   1      }
