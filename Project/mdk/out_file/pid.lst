   15          //直行速度环
   16          void speed_loop(void)
   17          {
   18   1          static int16 last_err_speed=0;
   19   1          static int16 last_last_err_speed=0;
   20   1          static float speed_output=0;//总输出
   21   1        //1-误差计算
   22   1         last_last_err_speed = last_err_speed;
   23   1         last_err_speed = err_speed; 
   24   1         err_speed = speed_target - speed_avl;
   25   1        
   26   1      //2—增量式PI控制
   27   1          speed_output =  pid_loop_speed.Kp * (err_speed - last_err_speed)
   28   1                        + pid_loop_speed.Ki *  err_speed 
   29   1                        + pid_loop_speed.Kd * (err_speed - 2*last_err_speed + last_last_err_speed);
   30   1        
   31   1        //增量
   32   1        if(speed_output>2000 ){speed_output=2000; }
   33   1        if(speed_output<-2000){speed_output=-2000;}
   34   1        
   35   1        //输出
   36   1        out_L+= speed_output;
   37   1        out_R = out_L;
   38   1        
   39   1        if(out_L>5000 ){out_L=5000; }
   40   1        if(out_L<-5000){out_L=-5000;}
   41   1        if(out_R>5000 ){out_R=5000; }
   42   1        if(out_R<-5000){out_R=-5000;} 
   43   1      }
