   74          //========================================================================
   75          // 速度环（内环）
   76          //========================================================================
   77          void speed_loop_LR(int16 speed_L_t,int16 speed_R_t)
   78          {
   79   1        //0-编码器输入更新
   80   1        static int16 err_speed_L_last=0,err_speed_L=0;
   81   1         
   82   1        static int16 err_speed_R_last=0,err_speed_R=0;
   83   1         
   84   1        
   85   1        //1-误差计算
   86   1        err_speed_L_last = err_speed_L;
   87   1        err_speed_L = speed_L_t - speed_L;
   88   1        
   89   1        
   90   1        
   91   1        //2-控制
   92   1        speed_output_L = pid_loop_speed.Kp * (err_speed_L - err_speed_L_last)
   93   1                          + pid_loop_speed.Ki * err_speed_L;
   94   1      
   95   1        //增量
   96   1        if(speed_output_L>2000 ){speed_output_L=2000; }
   97   1        if(speed_output_L<-2000){speed_output_L=-2000;}
   98   1        
   99   1        //输出
  100   1        out_L += speed_output_L;
  101   1        
  102   1        
  103   1        
  104   1        //0-编码器输入更新
  105   1        
  106   1        //1-误差计算
  107   1        err_speed_R_last = err_speed_R;
  108   1        err_speed_R = speed_R_t - speed_R;
  109   1        
  110   1        //2-控制
  111   1        speed_output_R =  pid_loop_speed.Kp * (err_speed_R - err_speed_R_last)
  112   1                          + pid_loop_speed.Ki *  err_speed_R;
  113   1      
  114   1        //增量
  115   1        if(speed_output_R>2000 ){speed_output_R=2000; }
  116   1        if(speed_output_R<-2000){speed_output_R=-2000;}
  117   1        
  118   1        //输出
  119   1        out_R += speed_output_R;
  120   1        
  121   1        if(out_L>3500 ){out_L=3500; }
  122   1        if(out_L<-3500){out_L=-3500;}
  123   1        if(out_R>3500 ){out_R=3500; }
