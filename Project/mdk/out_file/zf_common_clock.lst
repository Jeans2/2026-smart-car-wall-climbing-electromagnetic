  132          void clock_init (uint32 clock)                                              // 核心时钟初始化
  133          {
  134   1        EAXFR = 1;        // 使能访问XFR
  135   1        P_SW2 = 0x80;           // 开启特殊地址访问
  136   1          CKCON = 0x00;           // 设置外部数据总线为最快
  137   1          WTST = 0;               // 设置程序代码等待参数，赋值为0可将CPU执行程序的速度�
             -��置为最快
  138   1      
  139   1      #if (1 == EXTERNAL_CRYSTA_ENABLE)
                 XOSCCR = 0xc0;      //启动外部晶振
                 while (!(XOSCCR & 1));  //等待时钟稳定
                 CLKDIV = 0x00;      //时钟不分频
                 CLKSEL = 0x01;      //选择外部晶振
               #else
  145   1        //自动设置系统频率
  146   1        #if (0 == FOSC)
  147   1          system_clock = set_sys_clk(clock);
  148   1        #else
                   system_clock = FOSC;
                 #endif
  151   1      #endif
  152   1      
  153   1        system_delay_init();    // 延时函数初始化
  154   1      
  155   1       
  156   1        P0M0 = 0x00;
  157   1        P0M1 = 0x00;
  158   1        P1M0 = 0x00;
  159   1        P1M1 = 0x00;
  160   1        P2M0 = 0x00;
  161   1        P2M1 = 0x00;
  162   1        P3M0 = 0x00;
  163   1        P3M1 = 0x00;
  164   1        P4M0 = 0x00;
  165   1        P4M1 = 0x00;
  166   1        P5M0 = 0x00;
  167   1        P5M1 = 0x00;
  168   1        P6M0 = 0x00;
  169   1        P6M1 = 0x00;
  170   1        P7M0 = 0x00;
  171   1        P7M1 = 0x00;
  172   1        
  173   1        ADCCFG = 0;
  174   1        AUXR = 0;
  175   1        SCON = 0;
  176   1        S2CON = 0;
  177   1        S3CON = 0;
  178   1        S4CON = 0;
  179   1        P_SW1 = 0;
