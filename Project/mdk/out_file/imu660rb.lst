   35          // =========================================================================
   36          // 函数名：gyro_init_calibration
   37          // 功  能：开机静止状态下采集零漂 (必须在 main 函数的 while(1) 之前调用一次)
   38          // =========================================================================
   39          void gyro_init_calibration(void)
   40          {
   41   1          int i;
   42   1          float temp_z = 0, temp_x = 0;
   43   1          
   44   1          // 连续采集 500 次求平均值
   45   1          for(i = 0; i < 500; i++)
   46   1          {
   47   2              imu660rb_get_gyro(); 
   48   2              temp_z += imu660rb_gyro_transition(imu660rb_gyro_z);
   49   2              temp_x += imu660rb_gyro_transition(imu660rb_gyro_x);
   50   2              system_delay_ms(1); 
   51   2          }
   52   1          null_drift_z = temp_z / 500.0f;
   53   1          null_drift_x = temp_x / 500.0f;
   54   1      }
   55          
