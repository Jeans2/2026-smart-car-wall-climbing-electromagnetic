   58          // 功  能：获取角速度 (扣除零漂 + 软件死区过滤)
   59          // =========================================================================
   60          void gyro_get_z(void)      
   61          {
   62   1          imu660rb_get_gyro();        
   63   1          gyro_z = imu660rb_gyro_transition(imu660rb_gyro_z) - null_drift_z;
   64   1          
   65   1          // 软件死区：彻底杀死静态微小漂移
   66   1          if(gyro_z > -0.5f && gyro_z < 0.5f) gyro_z = 0;
   67   1          
   68   1          avl_gyro_z = gyro_z;
   69   1          gyro_z_filtered = alpha * gyro_z_filtered + (1 - alpha) * avl_gyro_z;
   70   1      }
