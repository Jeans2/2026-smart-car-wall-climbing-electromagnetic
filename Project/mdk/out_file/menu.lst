   37   1          memcpy(&save_buf[5],  &pid_loop_speed.Ki, 4);
   38   1          memcpy(&save_buf[9],  &pid_motor_run.Kp,  4);
   39   1          memcpy(&save_buf[13], &pid_motor_run.Kd,  4);
   40   1          memcpy(&save_buf[17], &adc_set_differ.A,  4);
   41   1          memcpy(&save_buf[21], &adc_set_differ.B,  4);
   42   1          memcpy(&save_buf[25], &adc_set_differ.C,  4);
   43   1      
   44   1          // 调用逐飞库的“读-改-写”安全函数写入数据
   45   1          extern_iap_write_buff(EEPROM_PARAM_ADDR, save_buf, 29);
   46   1      }
