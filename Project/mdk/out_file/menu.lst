   25          // =========================================================================
   26          // 函数名：Save_Params_To_EEPROM
   27          // 功  能：将所有调参数据打包并保存到 EEPROM
   28          // =========================================================================
   29          void Save_Params_To_EEPROM(void)
   30          {
   31   1          uint8 save_buf[29]; // 1个标志位 + 7个float(共28字节) = 29字节
   32   1          
   33   1          save_buf[0] = EEPROM_INIT_FLAG; // 写入校验标志位
